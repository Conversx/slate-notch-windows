<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK suffix is what turns on the WinRT projections; without it
         Windows.Media.Control (the whole reason this port is worth doing) is invisible. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.Screen, which is still the least painful way to
         ask which monitor the cursor is on. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Slate</AssemblyName>
    <RootNamespace>Slate</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- `UseWindowsForms` brings System.Windows.Forms and System.Drawing in as implicit
         global usings across every file, where they collide head-on with WPF: Application,
         Brush, Color, Point, Size, DragEventArgs and UserControl all exist in both, and
         the first build failed with CS0104 on every one of them.

         WinForms is here for a single type — Screen — so the global usings are dropped and
         ScreenMetrics aliases what it needs. WPF's names then mean what they say
         everywhere else, which for a WPF app is the right way round. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Windows volume mixer is COM: IMMDeviceEnumerator, IAudioSessionManager2,
         ISimpleAudioVolume. Hand-written interop means hand-written vtables, and a
         vtable in the wrong order is a crash rather than a compile error — a poor bet
         in code that cannot be run here. NAudio is the mature wrapper for exactly this. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
